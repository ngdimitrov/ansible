{{ ansible_managed | comment }}
server:
  http_listen_address: {{ promtail_listen_address }}
  http_listen_port: {{ promtail_http_port }}
  grpc_listen_address: {{ promtail_listen_address }}
  grpc_listen_port: {{ promtail_grpc_port }}

positions:
  filename: {{ promtail_positions_file }}

clients:
  - url: {{ promtail_loki_url }}

scrape_configs:
{{ promtail_scrape_configs | to_nice_yaml(indent=2) | indent(2, true) }}
